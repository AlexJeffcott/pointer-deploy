{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Sub-apps import the shell store by the name the import map uses. The
    // bundler marks it external, so this mapping is for typechecking only -
    // nothing is inlined. These two specifiers are also the two halves of the
    // contract; the matrix re-points them at a contract's .d.ts files, and
    // these are the head values.
    "paths": {
      "@pointer/shell": ["./src/web/shell/api.ts"],
      "@pointer/subapp": ["./src/web/shell/subapp.ts"],

      // The server-to-shell surface, §11. By specifier for the same reason the
      // two above are: the member reading re-points it at a copy with one
      // declaration cut out, and a relative path cannot be re-pointed. Types
      // only, so every import of it is erased and nothing resolves this at
      // runtime - which matters because the image carries no tsconfig.
      "@pointer/blocks": ["./src/server/blocks.ts"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun-types"],

    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "build.ts", "scripts", "features"]
}

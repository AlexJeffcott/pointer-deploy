{
  "name": "pointer-deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production bun run build.ts",
    "start": "bun src/server/index.ts",
    "dev": "bun --watch src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "contract:mint": "bun run scripts/contract-mint.ts",
    "contract:matrix": "bun run scripts/contract-matrix.ts",
    "contract:members": "bun run scripts/contract-members.ts",
    "contract:deprecate": "bun run scripts/contract-deprecate.ts",
    "blocks:record": "bun run scripts/blocks-record.ts",
    "test": "bun test src/server src/web scripts api features/support",
    "publish": "bun run scripts/publish.ts",
    "promote": "bun run scripts/promote.ts",
    "units": "bun run scripts/units.ts",
    "verify": "HARNESS=local bun node_modules/playwright-bdd/dist/cli/index.js test --tags @local && HARNESS=local bun node_modules/@playwright/test/cli.js test",
    "verify:live": "HARNESS=live bun node_modules/playwright-bdd/dist/cli/index.js test --tags '@live and not @needs-domain' && HARNESS=live bun node_modules/@playwright/test/cli.js test",
    "verify:all": "bun run verify && bun run verify:live && bun run verify:browser",
    "falsify": "bun run scripts/falsify.ts",
    "e2e": "bun run scripts/e2e-independent-deploy.ts",
    "e2e:members": "bun run scripts/e2e-member-gate.ts",
    "setup:store": "bun run scripts/setup-store.ts",
    "fixture:schema-2": "bun run scripts/publish-schema-2-fixture.ts",
    "mutate": "stryker run",
    "verify:browser": "HARNESS=live bun node_modules/playwright-bdd/dist/cli/index.js test --tags @browser && HARNESS=live bun node_modules/@playwright/test/cli.js test",
    "sweep": "bun run scripts/sweep-superseded.ts",
    "measure:preload": "bun run scripts/measure-preload.ts",
    "e2e:api": "bun run scripts/e2e-api-gate.ts",
    "e2e:deprecation": "bun run scripts/e2e-deprecation.ts"
  },
  "dependencies": {
    "preact": "^10.27.2",
    "@preact/signals": "^2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/bun": "^1.4.0",
    "playwright-bdd": "^9.2.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3"
  }
}

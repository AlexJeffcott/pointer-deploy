# Copy to .env.local. `fly storage create` prints these.
# The Fly app does NOT need them - only publish.ts and promote.ts do.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
BUCKET_NAME=
ASSET_BASE=https://<bucket>.fly.storage.tigris.dev

# The snapshot bucket, `PLAN.md` step 6. A SECOND bucket and a SECOND key, and
# the reason is that the key above can write the files the origin executes.
# `bun run verify:keys` measures that this one cannot.
DATA_AWS_ACCESS_KEY_ID=
DATA_AWS_SECRET_ACCESS_KEY=
DATA_AWS_REGION=auto
DATA_BUCKET_NAME=
